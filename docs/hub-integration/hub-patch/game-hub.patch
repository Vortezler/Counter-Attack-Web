diff --git a/tests/browser/cs-web.spec.js b/tests/browser/cs-web.spec.js
new file mode 100644
index 0000000..d4fba3b
--- /dev/null
+++ b/tests/browser/cs-web.spec.js
@@ -0,0 +1,138 @@
+import { randomUUID } from 'node:crypto';
+import { mkdir } from 'node:fs/promises';
+import { resolve } from 'node:path';
+import { test, expect } from '@playwright/test';
+
+const enabled = process.env.VITE_ENABLE_CS_WEB === 'true';
+const callsign = page => page.getByRole('textbox', { name: /player name|display name|callsign/i });
+
+function sessionFingerprint(page) {
+  return page.evaluate(async () => {
+    const session = localStorage.getItem('game-hub-auth');
+    if (!session) return null;
+    const hash = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(session));
+    return Array.from(new Uint8Array(hash), value => value.toString(16).padStart(2, '0')).join('');
+  });
+}
+
+async function capture(page, filename) {
+  if (!process.env.CS_WEB_SCREENSHOTS) return;
+  await mkdir(process.env.CS_WEB_SCREENSHOTS, { recursive: true });
+  await page.screenshot({ path: resolve(process.env.CS_WEB_SCREENSHOTS, filename), fullPage: true });
+}
+
+test('the catalog flag controls the CS Web card', async ({ page }) => {
+  await page.goto('/game-hub/');
+  await expect(page.locator('#game-link')).toBeAttached();
+  const card = page.locator('#cs-web-link');
+  if (enabled) {
+    await expect(card).toHaveAttribute('href', '/cs-web/');
+    await expect(page.locator('#cs-web-title')).toHaveText('CS Web');
+  } else {
+    await expect(card).toHaveCount(0);
+  }
+});
+
+test.describe('CS Web integration', () => {
+  test.skip(!enabled, 'The CS Web catalog card is disabled for this build.');
+
+  test('a hub guest launches the game, retains their identity, and returns', async ({ page }) => {
+    await page.goto('/game-hub/');
+    const name = 'Echo ' + randomUUID().slice(0, 6);
+    await page.getByLabel('Display name', { exact: true }).fill(name);
+    await page.getByRole('button', { name: 'Continue', exact: true }).click();
+    await expect(page.locator('#identity')).toContainText(name);
+    const session = await sessionFingerprint(page);
+    expect(session).toBeTruthy();
+    await capture(page, 'hub-card.png');
+    await page.getByRole('link', { name: 'Play CS Web' }).click();
+    await expect(page).toHaveURL(/\/cs-web\/$/);
+    await expect(callsign(page)).toHaveValue(name);
+    await capture(page, 'game-menu.png');
+    expect(await sessionFingerprint(page)).toBe(session);
+    await page.getByRole('link', { name: /back to game hub/i }).click();
+    await expect(page).toHaveURL(/\/game-hub\/$/);
+    await expect(page.locator('#identity')).toContainText(name);
+    for (const id of ['game-link', 'poker-link', 'cs-web-link']) await expect(page.locator('#' + id)).toBeVisible();
+    await capture(page, 'hub-return.png');
+  });
+
+  test('solo entry keeps its local name when guest verification is unavailable', async ({ page }) => {
+    await page.goto('/game-hub/');
+    await page.getByLabel('Display name', { exact: true }).fill('Hub guest');
+    await page.getByRole('button', { name: 'Continue', exact: true }).click();
+    await expect(page.locator('#identity')).toContainText('Hub guest');
+    await page.evaluate(() => localStorage.setItem('cs-web:player-name', 'Local pilot'));
+    const session = await sessionFingerprint(page);
+    await page.route('**/auth/v1/user*', route => route.abort());
+    await page.getByRole('link', { name: 'Play CS Web' }).click();
+    await expect(callsign(page)).toHaveValue('Local pilot', { timeout: 12000 });
+    expect(await sessionFingerprint(page)).toBe(session);
+  });
+
+  test('room links recover to the solo lobby and remain reloadable', async ({ page }) => {
+    await page.goto('/cs-web/?lobby=' + randomUUID());
+    await expect(page.getByText(/shared rooms for CS Web/i)).toBeVisible();
+    await expect(page).toHaveURL(/\/cs-web\/$/);
+    await page.reload();
+    await expect(callsign(page)).toBeVisible();
+    await page.goto('/cs-web/?room=invalid');
+    await expect(page.getByText(/room link is invalid/i)).toBeVisible();
+    await expect(page).toHaveURL(/\/cs-web\/$/);
+  });
+
+  test('a bot match advances under the production security policy', async ({ page }) => {
+    test.setTimeout(75000);
+    const errors = [];
+    page.on('pageerror', error => errors.push(error.message));
+    page.on('console', message => { if (message.type() === 'error') errors.push(message.text()); });
+    await page.addInitScript(() => {
+      window.cswViolations = [];
+      document.addEventListener('securitypolicyviolation', event => window.cswViolations.push(event.effectiveDirective));
+    });
+    await page.goto('/cs-web/?autostart=1&botsonly=1');
+    const policy = await page.locator('meta[http-equiv="Content-Security-Policy"]').getAttribute('content');
+    expect(policy).toContain("'wasm-unsafe-eval'");
+    expect(policy).not.toContain("'unsafe-eval'");
+    await expect(page.locator('[data-phase="live"]')).toBeVisible({ timeout: 60000 });
+    const timer = page.getByTestId('round-timer');
+    await expect(timer).toBeVisible();
+    await expect(timer).not.toHaveText(await timer.innerText(), { timeout: 6000 });
+    expect(await page.evaluate(() => window.cswViolations)).toEqual([]);
+    expect(errors).toEqual([]);
+  });
+
+  test('the solo lobby supports a small screen and keyboard navigation', async ({ page }) => {
+    await page.setViewportSize({ width: 360, height: 800 });
+    await page.goto('/cs-web/');
+    const name = callsign(page);
+    await expect(name).toBeVisible();
+    expect(await page.evaluate(() => document.documentElement.scrollWidth <= innerWidth)).toBe(true);
+    for (let press = 0; press < 50 && !await name.evaluate(el => document.activeElement === el); press++) {
+      await page.keyboard.press('Tab');
+    }
+    await expect(name).toBeFocused();
+    await name.fill('Keyboard pilot');
+    const back = page.getByRole('link', { name: /back to game hub/i });
+    for (let press = 0; press < 50 && !await back.evaluate(el => document.activeElement === el); press++) {
+      await page.keyboard.press('Tab');
+    }
+    await expect(back).toBeFocused();
+    await page.keyboard.press('Enter');
+    await expect(page).toHaveURL(/\/game-hub\/$/);
+  });
+
+  test('a player opens the Mirage armory and buys a defuse kit', async ({ page }) => {
+    test.setTimeout(60000);
+    await page.goto('/cs-web/?autostart=1&map=mirage&side=CT');
+    await expect(page.locator('[data-phase="freeze"]')).toBeVisible({timeout: 45000});
+    await page.locator('canvas[aria-label="First-person game view"]').focus();
+    await page.keyboard.press('b');
+    const armory = page.getByRole('dialog', { name:'Buy menu' });
+    await expect(armory).toBeVisible();
+    await armory.getByRole('button', { name:/equipment/i }).click();
+    await armory.getByRole('button', { name:/defuse kit/i }).click();
+    await expect(armory.getByText(/kit equipped/i)).toBeVisible();
+    await capture(page, 'buy-menu.png');
+  });
+});
